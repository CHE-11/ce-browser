{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Deps",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#8fbce1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Run Dev",
      "type": "shell",
      "command": "pnpm tauri dev",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#cef413"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "ce-browser",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ce-browser\\.exe|Finished .*dev.* profile"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Bump",
      "type": "shell",
      "command": "pnpm version:bump",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#c49816"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm build:exe",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#35f835"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Publish",
      "type": "shell",
      "command": "pnpm publish:exe",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#c084fc"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Install/Run App",
      "type": "shell",
      "command": "pnpm install:exe",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "color": "#1afbff"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "close": true
      }
    }
  ]
}
