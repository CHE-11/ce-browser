{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Browser UI, popups and ce:// pages. Remote sites in tabs match no capability and cannot invoke commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default"
  ]
}
